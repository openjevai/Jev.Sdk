{
  // ---------------------------------------------------------------------------------------------
  // the-lighthouse.json
  //
  // The same engine, a bigger world. This exists to prove the schema is a schema and not a
  // one-game trick: nothing in the engine knows about lighthouses, storms, fuel, or radio. It is
  // Escape the Room with five times the state and five times the rules, and the engine was not
  // touched to run it.
  //
  // Setting: you are the keeper of a lighthouse on a rock, mid-storm, and the lamp has gone out.
  // A ship is inbound. You have until dawn.
  // ---------------------------------------------------------------------------------------------

  "schemaVersion": "1.0",
  "id": "the-lighthouse",
  "title": "The Lighthouse",
  "goal": "The lamp has gone out and a ship is inbound. You are alone on the rock until dawn. Get the light back on.",

  "examples": [
    "check the fuel gauge",
    "prime the generator",
    "wrap the cracked pipe with tape",
    "radio the ship",
    "climb the tower and light the lamp"
  ],

  "state": [
    { "key": "fuel_primed",   "type": "bool", "initial": false,
      "describe": { "true": "The generator is primed and holding pressure.", "false": "The generator is dry and unprimed." } },
    { "key": "pipe_sealed",   "type": "bool", "initial": false,
      "describe": { "true": "The cracked fuel line is wrapped and holding.", "false": "A fuel line is cracked and weeping." } },
    { "key": "lamp_lit",      "type": "bool", "initial": false,
      "describe": { "true": "The lamp is burning, sweeping the water.", "false": "The lamp above you is dark." } },
    { "key": "radio_working", "type": "bool", "initial": false,
      "describe": { "true": "The radio is alive and hissing.", "false": "The radio is dead." } },
    { "key": "ship_warned",   "type": "bool", "initial": false,
      "describe": { "true": "The ship has been warned and is standing off.", "false": "The ship has not been warned." } },
    { "key": "injured",       "type": "bool", "initial": false,
      "describe": { "true": "Your hand is hurt and slowing you down.", "false": "You are unhurt." } },
    { "key": "spare_parts",   "type": "int",  "initial": 2,
      "describe": { "2": "You have two spare parts on the bench.", "1": "You have one spare part left.", "0": "You are out of spare parts.", "*": "You have spare parts on the bench." } },
    { "key": "time_left",     "type": "int",  "initial": 12,
      "describe": { "*": "Dawn is coming. Every minute counts." } }
  ],

  "stateTemplate": "You are the keeper of a lighthouse on a bare rock in a storm. {{fuel_primed}} {{pipe_sealed}} {{lamp_lit}} {{radio_working}} {{ship_warned}} {{injured}} {{spare_parts}} {{time_left}}",

  "judgements": [
    {
      "key": "intent",
      "kind": "choice",
      "fallback": "other",
      "question": "The player typed: \"{{action}}\". Which single task are they attempting? Choose 'other' unless the text describes something they are actively trying to carry out - merely mentioning a piece of equipment is not attempting to use it.",
      "options": [
        { "key": "check_fuel",   "description": "Inspect, read, or dip the fuel tanks and gauge." },
        { "key": "prime_generator","description": "Prime, crank, bleed, or start the generator so it holds pressure." },
        { "key": "seal_pipe",    "description": "Repair, patch, tape, or clamp a leaking or cracked fuel line." },
        { "key": "light_lamp",   "description": "Climb the tower, strike a match, and light the lamp itself." },
        { "key": "fix_radio",    "description": "Repair, power, or tune the radio set." },
        { "key": "call_ship",    "description": "Transmit on the radio to warn or reach the incoming ship." },
        { "key": "rest",         "description": "Stop, breathe, bandage yourself, or take a moment before continuing." },
        { "key": "other",        "description": "Anything else: statements, questions, observations, thinking aloud, or actions that make no sense here. Prefer this whenever the text does not describe something the player is actively trying to do." }
      ]
    },
    {
      "key": "plausible",
      "kind": "noul",
      "fallback": "0.5",
      "question": "The player typed: \"{{action}}\". Could a person standing here physically carry that out? Judge only whether they could do it with their hands and the equipment described, not whether it will succeed and not whether it is wise. Reaching for something within arm's reach is possible, including walking to it first. Starting a generator with no fuel in it is not."
    },
    {
      "key": "dangerous",
      "kind": "noul",
      "fallback": "0.5",
      "question": "The player typed: \"{{action}}\". How likely is that to hurt them - a burn, a cut, a fall, a shock? Answer with the probability of injury. Fiddling with a cracked fuel line or climbing a wet iron tower is dangerous. Reading a gauge or resting is not."
    },
    {
      "key": "noise",
      "kind": "score",
      "fallback": "quiet",
      "levels": [ "silent", "quiet", "loud", "deafening" ],
      "question": "The player typed: \"{{action}}\". How much noise would carrying that out make over the storm? A generator coughing into life or metal crashing on stone is deafening. Reading a gauge or wrapping tape is silent or quiet."
    },
    {
      "key": "progress",
      "kind": "noul",
      "fallback": "0.5",
      "question": "The player typed: \"{{action}}\". If they attempt that, how likely is it to actually work, given the equipment and the state described? Answer with the probability that the attempt succeeds at moving them toward getting the light back on."
    }
  ],

  "rules": [
    {
      "id": "time_runs_out",
      "when": { "state": "time_left", "below": 1 },
      "narrate": [ "The sky greys. Dawn." ],
      "then": [ { "kind": "lose" } ]
    },
    {
      "id": "implausible",
      "when": { "judgement": "plausible", "below": 0.45 },
      "narrate": [ "Your hands find nothing that would let you do that." ],
      "then": [ { "kind": "narrate", "text": "nothing" } ]
    },
    {
      "id": "injury",
      "when": { "all": [
        { "state": "injured", "equals": "false" },
        { "roll": { "chanceFrom": "dangerous", "atLeast": 0.6 } }
      ] },
      "narrate": [ "Something tears or burns. You are bleeding and slower now." ],
      "then": [
        { "kind": "set", "state": "injured", "to": "true" },
        { "kind": "increment", "state": "time_left", "by": -1 }
      ]
    },
    {
      "id": "check_fuel",
      "when": { "judgement": "intent", "equals": "check_fuel" },
      "narrate": [ "You dip the tank. There is fuel, but the line will not hold it yet." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": -1 } ]
    },
    {
      "id": "seal_pipe_without_parts",
      "when": { "all": [
        { "judgement": "intent", "equals": "seal_pipe" },
        { "state": "spare_parts", "below": 1 }
      ] },
      "narrate": [ "You have nothing left to wrap it with." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": -1 } ]
    },
    {
      "id": "seal_pipe",
      "when": { "all": [
        { "judgement": "intent", "equals": "seal_pipe" },
        { "state": "pipe_sealed", "equals": "false" }
      ] },
      "narrate": [ "You wrap the crack in tape and clamp it down. It holds." ],
      "then": [
        { "kind": "set", "state": "pipe_sealed", "to": "true" },
        { "kind": "increment", "state": "spare_parts", "by": -1 },
        { "kind": "increment", "state": "time_left", "by": -1 }
      ]
    },
    {
      "id": "prime_without_seal",
      "when": { "all": [
        { "judgement": "intent", "equals": "prime_generator" },
        { "state": "pipe_sealed", "equals": "false" }
      ] },
      "narrate": [ "The generator turns over and dies. Fuel is running out of the crack as fast as you can get it in." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": -1 } ]
    },
    {
      "id": "prime_generator",
      "when": { "all": [
        { "judgement": "intent", "equals": "prime_generator" },
        { "state": "fuel_primed", "equals": "false" }
      ] },
      "narrate": [ "The generator catches, coughs, and settles into a steady shake. The pressure gauge climbs." ],
      "then": [
        { "kind": "set", "state": "fuel_primed", "to": "true" },
        { "kind": "increment", "state": "time_left", "by": -1 }
      ]
    },
    {
      "id": "light_lamp_without_fuel",
      "when": { "all": [
        { "judgement": "intent", "equals": "light_lamp" },
        { "state": "fuel_primed", "equals": "false" }
      ] },
      "narrate": [ "You strike a match and touch it to the burner. Nothing catches. No pressure, no light." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": -1 } ]
    },
    {
      "id": "light_lamp_win",
      "when": { "all": [
        { "judgement": "intent", "equals": "light_lamp" },
        { "state": "fuel_primed", "equals": "true" }
      ] },
      "narrate": [ "The burner catches with a thump you feel through the floor.", "The lamp swings into life, and the whole rock throws a long beam out across the water.", "Aboard the ship, someone sees it." ],
      "then": [ { "kind": "win" } ]
    },
    {
      "id": "fix_radio",
      "when": { "all": [
        { "judgement": "intent", "equals": "fix_radio" },
        { "state": "radio_working", "equals": "false" }
      ] },
      "narrate": [ "You reseat the valves and the set hisses into life." ],
      "then": [
        { "kind": "set", "state": "radio_working", "to": "true" },
        { "kind": "increment", "state": "time_left", "by": -1 }
      ]
    },
    {
      "id": "call_ship_without_radio",
      "when": { "all": [
        { "judgement": "intent", "equals": "call_ship" },
        { "state": "radio_working", "equals": "false" }
      ] },
      "narrate": [ "You key the microphone and get only static. The set is dead." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": -1 } ]
    },
    {
      "id": "call_ship_win",
      "when": { "judgement": "intent", "equals": "call_ship" },
      "narrate": [ "You call into the dark and a voice comes back, faint and startled.", "\"Lighthouse, we have you. Standing off until dawn.\"", "The ship turns away from the rocks." ],
      "then": [ { "kind": "win" } ]
    },
    {
      "id": "rest",
      "when": { "judgement": "intent", "equals": "rest" },
      "narrate": [ "You sit on the cold step for a moment and get your breath. The clock does not stop." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": -1 } ]
    },
    {
      // The catch-all: a creative action the designer never anticipated still costs time, and if the
      // model thought it had a real chance of working it buys something back.
      "id": "creative",
      "when": { "all": [
        { "judgement": "intent", "equals": "other" },
        { "roll": { "chanceFrom": "progress", "atLeast": 0.55 } }
      ] },
      "narrate": [ "Not what you meant to do, but it buys you something." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": 1 } ]
    },
    {
      "id": "nothing",
      "narrate": [ "Nothing comes of it. The storm does not care." ],
      "then": [ { "kind": "increment", "state": "time_left", "by": -1 } ]
    }
  ],

  "ending": {
    "won": "The light is on. Whatever happens next is tomorrow's problem.",
    "lost": "The light never came on."
  },

  "turnLimit": 40
}
