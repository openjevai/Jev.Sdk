# .env.example — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. This template is tracked on purpose so the
# expected variables are discoverable without reading the source.
#
# .env is read by the SAMPLE client only. The library itself does not read this file: .NET's
# configuration system reads environment variables, and the sample loads this file into the
# process environment at startup so the variables below arrive the same way a shell-exported
# variable would. Nothing in Jev.Sdk or Jev.Sdk.DependencyInjection opens a .env file.
#
# Precedence, highest first (see the library's JevConfigurationLoader):
#   1. an API key passed to the client, or as the sample's first argument
#   2. these environment variables
#   3. appSettings.{MACHINE_NAME}.json
#   4. appSettings.json
#
# ApiKey and DefaultModel below use the literal placeholder "REPLACE ME", deliberately identical to
# the placeholders in appSettings.json — one convention in both files, so there is one thing to
# recognise. Values are left unquoted; quotes are stripped if present, so either form works.

# Required. Your TypeSafe API key. Never commit a real value.
TYPESAFE_API_KEY=REPLACE ME

# Optional. The model used when a call does not name one. The alias "jev-latest" resolves to the
# current flagship model.
# Default when unset: jev-latest
TYPESAFE_DEFAULT_MODEL=REPLACE ME

# Optional. Selects appSettings.{MACHINE_NAME}.json. Defaults to the MACHINE_NAME environment
# variable, then to the machine's own name. A container's hostname changes when it is recreated,
# which is why this override exists.
MACHINE_NAME=REPLACE ME

# NOTE: the two settings files the library reads are appSettings.json and
# appSettings.{MACHINE_NAME}.json - there is no "Local" or "Development" file. Put a real key in
# the machine-specific one (git-ignored), or here in .env, or in the environment.

# TWO VARIABLES ARE COMMENTED OUT ON PURPOSE.
#
# BaseAddress and DefaultModel above are free-form strings, so a placeholder is harmless: the
# environment path ignores an unparseable value instead of throwing. The two below are also typed,
# but the asymmetry is the point — a value here is only read when the corresponding option is still
# at its default, and an unusable one is silently ignored rather than fatal. They are commented out
# to avoid implying that "REPLACE ME" would take effect, because it would not.

# Optional. Override the API base address. Must be an absolute URI.
# Default when unset: https://api.typesafe.ai
# TYPESAFE_BASE_URL=https://api.typesafe.ai
