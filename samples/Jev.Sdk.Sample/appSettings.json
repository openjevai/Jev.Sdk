{
  // appSettings.json — the generic settings file the library loads at host startup.
  //
  // This file is deliberately runnable as shipped: copy it, edit one value, run. Every member the
  // library accepts is listed, and all of them are optional — the client runs on its defaults with
  // no file at all.
  //
  // Precedence, highest first (see JevConfigurationLoader):
  //   1. an API key passed to the client
  //   2. the TYPESAFE_API_KEY environment variable
  //   3. appSettings.{MACHINE_NAME}.json
  //   4. this file
  //
  // The environment beats every file, and a machine-specific file overrides this one.
  //
  // ApiKey and DefaultModel use the same literal placeholder as .env.example, so there is one thing
  // to recognise across both files.
  //
  // Do not put a real key in this file: it is tracked by the repository, so the key would be
  // committed. Put the real key in appSettings.{MACHINE_NAME}.json (git-ignored), or in the
  // environment.
  //
  // The library reads EXACTLY TWO settings files: this one and appSettings.{MACHINE_NAME}.json.
  // There is no "Local" file and no "Development" file — save a copy of this one as
  // appSettings.<YOUR_MACHINE>.json to use the machine override, or set MACHINE_NAME to control
  // which name is looked for.
  //
  // Comments and trailing commas are accepted here: the library reads this with the permissive JSON
  // reader. If another tool of yours requires strict JSON, that is the one thing to know about this
  // file — the comments are the only non-strict part.

  "Jev": {
    // Required. Your TypeSafe API key.
    // The environment wins over this value. This placeholder is inert: the sample treats it as
    // "not configured" and prompts instead of sending it to the API.
    "ApiKey": "REPLACE ME",

    // Optional. Used when a call does not name a model. The alias "jev-latest" resolves to the
    // current flagship model.
    // Default when unset: jev-latest
    "DefaultModel": "REPLACE ME"

    // TWO MEMBERS ARE COMMENTED OUT ON PURPOSE.
    //
    // BaseAddress and Timeout are typed — an absolute URI and a TimeSpan — so "REPLACE ME" is not a
    // legal value for either. This file is loaded whenever it is present, so an unusable placeholder
    // here would make configuration loading fail before the client ever ran. They are commented out
    // rather than given a placeholder that cannot work. Uncomment and supply a real value to use them.

    // Optional. Must be an absolute URI. The environment path ignores an unparseable value, but the
    // settings-file path throws, so it must be valid if present.
    // Default when unset: https://api.typesafe.ai
    // "BaseAddress": "https://api.typesafe.ai",

    // Optional. Per-attempt timeout in TimeSpan format; must be positive.
    // Default when unset: 00:00:10
    // "Timeout": "00:00:10"
  }
}
