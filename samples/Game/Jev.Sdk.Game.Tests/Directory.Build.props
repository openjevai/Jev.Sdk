<Project>

  <!-- The nearest Directory.Build.props wins, so the root one must be imported explicitly rather
       than inherited. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../../'))" />

  <PropertyGroup>
    <!-- Test method names are prose: the underscore separates the unit under test from the behaviour
         being asserted, which reads better in a failure report than a camel-cased sentence. Same
         convention as tests/Jev.Sdk.Tests, and suppressed for the same reason. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
