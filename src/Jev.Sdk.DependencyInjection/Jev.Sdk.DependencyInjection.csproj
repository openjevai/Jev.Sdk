<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jev.Sdk.DependencyInjection</RootNamespace>
    <AssemblyName>Jev.Sdk.DependencyInjection</AssemblyName>
    <PackageId>Jev.Sdk.DependencyInjection</PackageId>
    <Description>Dependency-injection and configuration integration for Jev.Sdk, the .NET client for the TypeSafe AI System One API.</Description>
    <PackageTags>typesafe;systemone;jev;sdk;dependency-injection;di</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <!-- Kept in step with Jev.Sdk. The two ship together and a version skew between them would
         be a support problem with no upside. -->
    <Version>0.1.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Jev.Sdk/Jev.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/Jev.Sdk.DependencyInjection.md" />
  </ItemGroup>

</Project>
