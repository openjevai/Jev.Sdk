<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment on a publicly visible type or member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The one place the version is declared. Everything else derives from it:
         eng/package_version.py reads this value and produces `<VersionPrefix>-<sha9>` for an
         untagged build, or the bare version when HEAD carries the matching `v<VersionPrefix>`
         tag. Never set <Version> in a project file - it would override the derived value, and
         the workflow's consistency check exists precisely to catch a package whose version
         disagrees with what was declared. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>deepseek-v4.1-flash (via Hermes Agent), under deep human review</Authors>
    <Company>Rob Chartier</Company>
    <Product>Jev.Sdk</Product>
    <Copyright>Copyright (c) 2026 Rob Chartier</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/robchartier/Jev.Sdk</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
